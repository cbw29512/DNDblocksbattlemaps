{
  "name": "dnd-blocks-battle-maps",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run compile:web && vite build --base=./",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --check web/app/builder.js && node --test tests/*.test.mjs",
    "check": "npm run typecheck && npm run test && npm run build",
    "compile:web": "tsc -p tsconfig.web.json"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vite": "8.3.3"
  }
}
